{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZViewer",
  "version": "0.1.0",
  "identifier": "com.zviewer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZViewer",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Graphics and Design",
    "shortDescription": "精美快速的看图软件",
    "longDescription": "毛玻璃现代 UI 的跨文件夹无缝浏览看图软件",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "languages": [
          "SimpChinese"
        ],
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRUJERDNDQTE5RTU0RkMKUldUOFZKNmhQTjNyVWt3WjJxRnJleU9HbjlURHR6bDJ5WlpVY0RLamxveGYvRDF0NHBjQmRna1gK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/superMC5657/z-viewer-release/releases/latest/download/latest.json",
        "https://github.com/superMC5657/z-viewer-release/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "store": {
      "apiBase": "http://127.0.0.1:8080",
      "buyUrl": "http://localhost:5173/buy/z-viewer",
      "product": "z-viewer",
      "licenseLevel": "pro",
      "licensePublicKeys": {
        "pro": "MCowBQYDK2VwAyEA+gWVk4RlJTwcqdFUhLbfeDV+R38Yi6Epck2UWQpJCyc="
      },
      "licenseFileName": "license.json",
      "activatePath": "/api/v1/apps/z-viewer/activate",
      "verifyPath": "/api/v1/apps/z-viewer/verify",
      "deactivatePath": "/api/v1/apps/z-viewer/deactivate",
      "analyticsPath": "/api/v1/apps/z-viewer/analytics",
      "analyticsToken": "cbf3231e1ac04073e444c65854d27b108b5f4671e2f025fffa12b021a19baad7"
    }
  }
}
